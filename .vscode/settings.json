{
    "platformio-ide.useBuiltinPIOCore": true,
    "platformio-ide.autoRebuildAutocompleteIndex": true,
    "platformio-ide.forceUpload": false,
    "platformio-ide.uploadPort": "/dev/ttyUSB2",
    "platformio-ide.monitorBaudRate": 9600,
    "platformio-ide.advancedEnv": "nanoatmega328new",
    // C/C++ IntelliSense optimizations
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.suggestSnippets": true,
    "C_Cpp.enhancedColorization": "enabled",
    // File associations
    "files.associations": {
        "*.ino": "cpp",
        "*.h": "c",
        "*.cpp": "cpp"
    },
    // Editor optimizations
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [
        80,
        120
    ],
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    // Search and file exclusions
    "search.exclude": {
        "**/.pio": true,
        "**/build": true,
        "**/.git": true,
        "**/node_modules": true
    },
    "files.exclude": {
        "**/.pio": true,
        "**/build": true
    },
    // Terminal settings
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.cwd": "${workspaceFolder}",
    // Arduino-specific settings
    "arduino.path": "/usr/bin/arduino",
    "arduino.logLevel": "info",
    // PlatformIO specific
    "platformio-ide.autoRebuildAutocompleteIndex": true,
    "platformio-ide.keepPIOProjectIntellisenseIndex": true,
    "platformio-ide.forceUpload": false,
    "platformio-ide.uploadPort": "/dev/ttyUSB2",
    "platformio-ide.monitorBaudRate": 9600,
    "platformio-ide.advancedEnv": "nanoatmega328new",
    // Build optimizations
    "platformio-ide.buildOnSave": false,
    "platformio-ide.uploadOnSave": false,
    // Code formatting
    "C_Cpp.clang_format_style": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 120 }",
    "C_Cpp.clang_format_fallbackStyle": "Google"
}